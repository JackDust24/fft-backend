{
  "kind": "collectionType",
  "collectionName": "memberships",
  "info": {
    "name": "Membership",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "membership_id": {
      "type": "string"
    },
    "created_date": {
      "type": "datetime"
    },
    "start_date": {
      "type": "date"
    },
    "end_date": {
      "type": "date"
    },
    "live": {
      "type": "boolean"
    },
    "membership_role": {
      "type": "enumeration",
      "enum": [
        "client",
        "member"
      ],
      "required": true
    },
    "expired": {
      "type": "boolean",
      "default": false
    },
    "member": {
      "plugin": "users-permissions",
      "model": "user"
    },
    "reminder_sent": {
      "type": "boolean"
    },
    "payment_type": {
      "type": "enumeration",
      "enum": [
        "Free",
        "QRPaid",
        "Payment"
      ]
    },
    "price": {
      "type": "decimal",
      "default": 0
    },
    "code": {
      "model": "codes"
    },
    "avatar": {
      "model": "file",
      "via": "related",
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ],
      "plugin": "upload",
      "required": false
    }
  }
}
