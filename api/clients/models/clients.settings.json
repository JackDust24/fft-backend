{
  "kind": "collectionType",
  "collectionName": "clients",
  "info": {
    "name": "Clients",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "business_name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "businessID": {
      "type": "uid",
      "private": false,
      "targetField": "business_name"
    },
    "InternalID": {
      "type": "string",
      "private": false,
      "unique": false
    },
    "client_user": {
      "plugin": "users-permissions",
      "model": "user"
    },
    "business_description": {
      "type": "richtext"
    },
    "client_contact": {
      "type": "string",
      "required": false
    },
    "client_email": {
      "type": "email"
    },
    "client_phone_number": {
      "type": "biginteger",
      "max": "15",
      "min": "1"
    },
    "membership_status": {
      "type": "string"
    },
    "membership_expiry": {
      "type": "date"
    },
    "promotions_allowed": {
      "type": "integer",
      "min": 0,
      "max": 14
    },
    "promotions_purchased": {
      "type": "integer"
    },
    "date_joined": {
      "type": "email"
    },
    "contact_business": {
      "type": "email"
    },
    "discount_info": {
      "type": "text"
    },
    "coordinates": {
      "type": "json"
    },
    "sales_rep": {
      "type": "string"
    },
    "orders": {
      "collection": "order"
    },
    "business_type": {
      "type": "string"
    },
    "setup_by": {
      "type": "string",
      "required": true,
      "default": "unknown"
    },
    "business_category": {
      "type": "string"
    },
    "business_sub_category": {
      "type": "string"
    },
    "terms": {
      "type": "boolean"
    },
    "sales_rep_email": {
      "type": "email"
    },
    "branches": {
      "via": "client",
      "collection": "branches"
    },
    "premium_membership": {
      "type": "boolean",
      "default": false
    },
    "membership_start": {
      "type": "date",
      "default": "2021-06-01T05:00:00.000Z"
    }
  }
}
