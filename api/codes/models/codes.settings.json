{
  "kind": "collectionType",
  "collectionName": "codes",
  "info": {
    "name": "Codes",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "packageImage": {
      "collection": "file",
      "via": "related",
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ],
      "plugin": "upload",
      "required": false
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "vat": {
      "type": "integer"
    },
    "tax": {
      "type": "integer"
    },
    "lengthOfPackage": {
      "type": "integer",
      "required": true
    },
    "promotions": {
      "type": "integer",
      "default": 0,
      "required": true
    },
    "code_added_by": {
      "type": "email",
      "required": true
    },
    "code_type": {
      "type": "enumeration",
      "enum": [
        "Package",
        "Membership",
        "Video"
      ]
    },
    "code": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "code",
      "required": true
    },
    "amount": {
      "type": "integer",
      "default": 0
    },
    "reason_for_code": {
      "type": "text",
      "private": true,
      "required": true
    },
    "free_months": {
      "type": "integer",
      "default": 0
    },
    "code_live": {
      "type": "boolean",
      "default": false
    },
    "code_valid": {
      "type": "boolean",
      "default": false
    },
    "admin_user": {
      "plugin": "admin",
      "model": "user"
    }
  }
}
